# Copy to .env and fill in. Never commit .env.

# Claude (reasoning + conversation). Budget: $90 total, see docs/project/budget.md
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# OpenAI (embeddings only). Budget: $5 total
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# Neon Postgres (pgvector enabled). Local: postgresql+asyncpg://postgres:postgres@localhost:5432/supfeel
DATABASE_URL=

# Frontend origin allowed by CORS (Vercel URL in prod)
CORS_ORIGINS=http://localhost:3000
# Optional: also allow Vercel preview deployments
CORS_ORIGIN_REGEX=

# Protects /api/admin/* (usage, reset, kb search). Change in production.
ADMIN_TOKEN=dev-admin-token

# Spend guardrails (USD). The app refuses LLM calls once a cap is hit.
LLM_BUDGET_HARD_CAP_USD=60
LLM_SESSION_CAP_USD=0.50
EMBEDDING_BUDGET_HARD_CAP_USD=3

# LLM_MODE: live | replay | mock
#   live   - real API calls (recorded to .llm-cache/)
#   replay - serve recorded responses, fail on cache miss (use for tests/CI)
#   mock   - deterministic canned responses (use for UI work)
LLM_MODE=mock

# GitHub App (docs/project/github-app-setup.md)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# Local: path to the .pem kept OUTSIDE the repo. Render: use a Secret File and point the path at it,
# or paste the whole PEM into GITHUB_APP_PRIVATE_KEY.
GITHUB_APP_PRIVATE_KEY_PATH=~/.secrets/supfeel-github-app.pem
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=

# Business notifications (optional; the dashboard inbox always works)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
PUBLIC_APP_URL=http://localhost:3000

# Workspaces / onboarding
OPEN_IMPORT=false            # true only for local dev (enables local-path imports for signed-in users)
ALLOW_LOCAL_REPOS=false
DEMO_GITHUB_REPO=            # e.g. ryl1k/slice-pizza: one-click demo in onboarding
